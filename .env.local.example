# =========================================
# ค่าตั้งระบบ — copy ไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)
# บน Vercel ให้ใส่ค่าเดียวกันที่ Project > Settings > Environment Variables
# เปลี่ยนค่าบน Vercel แล้วต้องกด Redeploy ถึงจะมีผล
# (ตัวที่ขึ้นต้นด้วย NEXT_PUBLIC_ ถูกฝังลงโค้ดหน้าเว็บตอน build — ต้อง Redeploy ทุกครั้ง)
# =========================================

# URL ของโปรเจกต์ Supabase — Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# คีย์สาธารณะ (anon public) — Supabase > Project Settings > API
# เปิดเผยในหน้าเว็บได้ เพราะข้อมูลถูกป้องกันด้วย RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# สำคัญ: คีย์ลับ (service_role) — Supabase > Project Settings > API
# ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น (หน้า "จัดการผู้ใช้" ใช้สร้าง/แก้ไขผู้ใช้)
# ห้ามใส่ NEXT_PUBLIC_ นำหน้า ห้ามส่งให้ใคร ห้ามแปะในแชท
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# (ไม่บังคับ) รหัสป้องกัน /api/cron/keepalive ไม่ให้คนนอกเรียก
# ตั้งเป็นข้อความสุ่มยาวๆ — Vercel จะส่ง "Authorization: Bearer <ค่านี้>" ให้เองตอนเรียก cron
# (ใช้กับ GET /api/integrations/worker?mode=daily ด้วย ถ้าตั้ง Vercel Cron ไว้)
CRON_SECRET=

# =========================================
# เมนู "ตั้งค่าการเชื่อมต่อ" (LINE SHOPPING / Facebook-IG / Shopee / Lazada / TikTok Shop)
# ทั้งหมดเป็นค่าฝั่งเซิร์ฟเวอร์ — ห้ามใส่ NEXT_PUBLIC_ นำหน้า ห้ามแปะในแชท
# =========================================

# [บังคับ] กุญแจเข้ารหัสคีย์/โทเคนของร้านก่อนเก็บลงฐานข้อมูล (AES-256-GCM) = base64 ของไบต์สุ่ม 32 ไบต์
# สร้าง: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ทำหาย = คีย์ที่บันทึกไว้ทั้งหมดถอดไม่ได้ ต้องกรอกคีย์ใหม่ทุกช่องทาง (เก็บสำรองไว้ในที่ปลอดภัย)
INTEGRATIONS_ENC_KEY=
# (ไม่บังคับ ค่าเริ่มต้น 1) เลขรุ่นของกุญแจ — เพิ่มทีละ 1 ทุกครั้งที่เปลี่ยนกุญแจ
INTEGRATIONS_ENC_KEY_VERSION=1
# (ใช้เฉพาะช่วงเปลี่ยนกุญแจ) กุญแจเดิม + เลขรุ่นเดิม — ถอดรหัสของเก่าได้ ส่วนการบันทึกใหม่ใช้กุญแจใหม่เสมอ
# INTEGRATIONS_ENC_KEY_PREVIOUS=
# INTEGRATIONS_ENC_KEY_PREVIOUS_VERSION=

# [บังคับ] รหัสลับของตัวทำงานเบื้องหลัง /api/integrations/worker (อย่างน้อย 32 ตัวอักษร)
# ต้องตรงกับค่าที่ใส่ใน Supabase Vault ชื่อ newcute_integrations_worker_secret (supabase-cron-integrations.sql)
# สร้าง: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTEGRATIONS_WORKER_SECRET=

# [บังคับ] ที่อยู่เว็บจริงของแอป ไม่มี / ท้าย — ใช้สร้างลิงก์ callback / webhook / ลิงก์ฟีด ให้ไปกรอกในหน้านักพัฒนาของแพลตฟอร์ม
APP_BASE_URL=https://newcutestock.vercel.app

# (ไม่บังคับ) Push URL ที่ลงทะเบียนกับ Shopee "ตรงทุกตัวอักษร" (เป็นส่วนหนึ่งของลายเซ็น webhook)
# ค่าเริ่มต้น = APP_BASE_URL + /api/integrations/shopee/webhook
# SHOPEE_PUSH_URL=

# (ไม่บังคับ) ลิงก์หน้าสินค้าในฟีดสินค้า ({group_id} / {sku} ถูกแทนค่า) — Meta บังคับว่าต้องเป็นหน้าเว็บของร้านเอง
# ค่าเริ่มต้น = APP_BASE_URL + /p/{group_id} (หน้าสินค้าสาธารณะยังไม่ได้สร้าง)
# FEED_PRODUCT_LINK_TEMPLATE=

# ใช้ตอนทดสอบบนเครื่องเท่านั้น (ห้ามตั้งบน Vercel): ยิงไป mock server บน 127.0.0.1 แทนเซิร์ฟเวอร์จริงของแพลตฟอร์ม
# มีผลเมื่อ VERCEL_ENV ไม่ใช่ production และเฉพาะ host loopback เท่านั้น
# INTEGRATIONS_ALLOW_TEST_HOSTS=1
# INTEGRATIONS_BASE_URL_OVERRIDES={"line":"http://127.0.0.1:4010","meta":"http://127.0.0.1:4011"}
